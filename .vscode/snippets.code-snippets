            "",
            "  @override",
            "  void onInit() {",
            "    super.onInit();",
            "    ${2:// Initialize service}",
            "  }",
            "",
            "  ${3:// Service methods here}",
            "}"
        ],
        "description": "Create an Ember service"
    }
}