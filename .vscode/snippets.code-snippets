    "Ember Command": {
        "prefix": "embercommand",
        "body": [
            "class ${1:CommandName} extends EmberCommand {",
            "  @override",
            "  final String name = '${2:command-name}';",
            "",
            "  @override",
            "  final String description = '${3:Command description}';",
            "",
            "  @override",
            "  String get invocationDetails => '${2:command-name}';",
            "",
            "  @override",
            "  List<String> get examples => ['${2:command-name}'];",
            "",
            "  ${1:CommandName}({required super.userInput, required super.userOutput});",
            "",
            "  @override",
            "  Future<dynamic> run() async {",
            "    ${4:// Implementation here}",
            "  }",
            "}"
        ],
        "description": "Create an Ember CLI command"
    },
    "Bess Widget": {
        "prefix": "besswidget",
        "body": [
            "class ${1:WidgetName} extends StatelessWidget {",
            "  const ${1:WidgetName}({super.key});",
            "",
            "  @override",
            "  Widget build(BuildContext context) {",
            "    return ${2:Container}(",
            "      ${3:// Widget implementation}",
            "    );",
            "  }",
            "}"
        ],
        "description": "Create a Bess UI widget"
    },
    "Flutter Obx Widget": {
        "prefix": "obx",
        "body": [
            "Obx(() => ${1:Widget}())"
        ],
        "description": "Create an Obx reactive widget"
    },
    "Ember Service": {
