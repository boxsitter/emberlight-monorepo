{
    "dart.flutterSdkPath": null,
    "dart.sdkPath": null,
    "dart.enableSdkFormatter": true,
    "dart.lineLength": 120,
    "dart.insertArgumentPlaceholders": false,
    "dart.previewLsp": true,
    "dart.debugExternalPackageLibraries": false,
    "dart.debugSdkLibraries": false,
    "dart.evaluateGettersInDebugViews": true,
    "dart.vmServicePort": 8181,
    // Flutter/Dart analysis settings
    "dart.analysisServerFolding": true,
    "dart.closingLabels": true,
    "dart.enableCompletionCommitCharacters": false,
    "dart.allowAnalytics": false,
    // File associations
    "files.associations": {
        "*.dart": "dart",
        "pubspec.yaml": "yaml",
        "melos.yaml": "yaml",
        "analysis_options.yaml": "yaml"
    },
    // File watching patterns for better performance
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/node_modules/*/**": true,
        "**/.hg/store/**": true,
        "**/.dart_tool/**": true,
        "**/build/**": true,
        "**/.pub/**": true,
        "**/.flutter-plugins": true,
        "**/.flutter-plugins-dependencies": true,
        "**/firebase-debug.log": true,
        "**/firestore-debug.log": true
    },
    // Search exclusions
    "search.exclude": {
        "**/.dart_tool": true,
        "**/build": true,
        "**/.pub": true,
        "**/node_modules": true,
        "**/.git": true,
        "**/firebase-debug.log": true,
        "**/firestore-debug.log": true
    },
    // Terminal settings
    "terminal.integrated.env.windows": {
        "FLUTTER_WEB_PORT": "8080",
        "FLUTTER_WEB_HOSTNAME": "0.0.0.0"
    },
    "terminal.integrated.env.linux": {
        "FLUTTER_WEB_PORT": "8080",
        "FLUTTER_WEB_HOSTNAME": "0.0.0.0"
    },
    "terminal.integrated.env.osx": {
        "FLUTTER_WEB_PORT": "8080",
        "FLUTTER_WEB_HOSTNAME": "0.0.0.0"
    },
    // Editor settings for Dart/Flutter
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.codeActionsOnSave": {
        "source.fixAll": "explicit",
        "source.organizeImports": "explicit"
    },
    // Multi-root workspace settings
    "explorer.compactFolders": false,
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
        "pubspec.yaml": "pubspec.lock,analysis_options.yaml,.flutter-plugins,.flutter-plugins-dependencies,.metadata",
        "*.dart": "${capture}.g.dart,${capture}.freezed.dart,${capture}.mocks.dart"
    }
}