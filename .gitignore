# ==> General Rules <==
# Ignore OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Ignore IDE specific files
*.iml
*.ipr
*.iws
*.hprof
*.psd

# Ignore sensitive files - BE CAUTIOUS AND ADD MORE AS NEEDED
*.pem
*.key
*.keypair
.env*
secret*.*
credentials*.*
# IMPORTANT: Never commit actual service account keys or secrets!

# ==> Dart & Flutter <==
# Ignore Dart tool directories and generated files
.dart_tool/
.packages
.pub-cache/ # If somehow generated locally within project
# Ignore Flutter tool files
.flutter-plugins
.flutter-plugins-dependencies
# Ignore build outputs
build/
# Ignore user-specific DevTools options
devtools_options.yaml

# ==> Pubspec Lock Files <==
# Ignore lockfiles in packages (libraries should not commit lockfiles)
packages/**/pubspec.lock
# ---> IMPORTANT: Do NOT ignore pubspec.lock in 'apps/' directory <---
#      Application lock files (e.g., apps/bessie_app/pubspec.lock)
#      SHOULD generally be committed to ensure reproducible builds.
#      Add an explicit un-ignore rule if a broader ignore exists,
#      or just rely on the specific ignore above for packages only.

# ==> Melos <==
.melos/
# Usually ignore overrides, generated by 'melos bootstrap'
pubspec_overrides.yaml

# ==> Platform Specific Build Artifacts <==
# Android
apps/**/android/.gradle/
apps/**/android/captures/
apps/**/android/*.keystore
apps/**/android/local.properties
# Note: apps/bessie_app/android/app/google-services.json SHOULD be committed.
# Add patterns here ONLY if you generate other specific debug/local versions elsewhere.

# iOS / macOS
apps/**/ios/Pods/
apps/**/ios/.symlinks/
apps/**/ios/Flutter/Flutter.podspec
apps/**/ios/Flutter/ephemeral/
apps/**/ios/Flutter/.last_build_id
apps/**/macos/Pods/
apps/**/macos/.symlinks/
apps/**/macos/Flutter/ephemeral/
apps/**/macos/Flutter/.last_build_id
# Xcode
apps/**/ios/*.xcworkspace/xcuserdata/
apps/**/ios/*.xcodeproj/xcuserdata/
apps/**/ios/*.xcodeproj/project.xcworkspace/
apps/**/macos/*.xcworkspace/xcuserdata/
apps/**/macos/*.xcodeproj/xcuserdata/
apps/**/macos/*.xcodeproj/project.xcworkspace/
apps/**/DerivedData/
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
# Note: apps/bessie_app/ios/Runner/GoogleService-Info.plist SHOULD be committed.

# Linux (Specific build outputs inside build/ covered above)
# Add specific Linux build artifacts if necessary

# Windows (Specific build outputs inside build/ covered above)
# Add specific Windows build artifacts if necessary

# Web (Specific build outputs inside build/ covered above)

# ==> Firebase <==
# Ignore Firebase emulator data and logs
*-debug.log
firestore-debug.log
database-debug.log
pubsub-debug.log
storage-debug.log
*.log
firebase-debug.log
*.sqlite
# Ignore emulator exports unless explicitly needed for seeding
.firebase/emu-storage/
emulator_data/
# Note: firebase.json and .firebaserc are often committed for CLI config,
# only ignore them if they contain local secrets or should not be shared.
# Note: firestore.indexes.json is usually committed.

# ==> Other common ignores <==
coverage/

# ==> Project Specific Ignores (Add below if needed) <==
# e.g., /secrets/my_secret_config.json

temp
