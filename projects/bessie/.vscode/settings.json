{
    "dart.flutterSdkPath": null,
    "dart.sdkPath": null,
    "dart.enableSdkFormatter": true,
    "dart.lineLength": 120,
    "dart.insertArgumentPlaceholders": false,
    "dart.previewLsp": true,
    "dart.debugExternalPackageLibraries": false,
    "dart.debugSdkLibraries": false,
    "dart.evaluateGettersInDebugViews": true,
    "dart.vmServicePort": 8181,
    "files.associations": {
        "*.dart": "dart",
        "pubspec.yaml": "yaml",
        "melos.yaml": "yaml",
        "analysis_options.yaml": "yaml"
    },
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.dart_tool/**": true,
        "**/build/**": true,
        "**/.pub/**": true,
        "**/.flutter-plugins": true,
        "**/.flutter-plugins-dependencies": true,
        "**/firebase-debug.log": true,
        "**/firestore-debug.log": true
    },
    "search.exclude": {
        "**/.dart_tool": true,
        "**/build": true,
        "**/.pub": true,
        "**/node_modules": true,
        "**/.git": true,
        "**/firebase-debug.log": true,
        "**/firestore-debug.log": true
    },
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.codeActionsOnSave": {
        "source.fixAll": "explicit",
        "source.organizeImports": "explicit"
    },
    "explorer.compactFolders": false,
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
        "pubspec.yaml": "pubspec.lock,analysis_options.yaml,.flutter-plugins,.flutter-plugins-dependencies,.metadata",
        "*.dart": "${capture}.g.dart,${capture}.freezed.dart,${capture}.mocks.dart"
    }
}