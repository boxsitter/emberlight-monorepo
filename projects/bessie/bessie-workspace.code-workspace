{
    "folders": [
        {
            "name": "📱 Bessie App",
            "path": "."
        },
        {
            "name": "🏠 Monorepo Root",
            "path": "../.."
        },
        {
            "name": "🛠️ EmDev CLI",
            "path": "../emdev"
        },
        {
            "name": "🔥 Ember Core",
            "path": "../../packages/ember_core"
        },
        {
            "name": "🔥 Ember Fire",
            "path": "../../packages/ember_fire"
        },
        {
            "name": "🎨 Bess UI",
            "path": "../../packages/bess_ui"
        },
        {
            "name": "⚡ CLI Utils",
            "path": "../../packages/ember_cli_utils"
        }
    ],
    "settings": {
        "dart.projectSearchPaths": [
            ".",
            "../emdev",
            "../../packages/ember_core",
            "../../packages/ember_fire",
            "../../packages/bess_ui",
            "../../packages/ember_cli_utils"
        ],
        "dart.enableSdkFormatter": true,
        "dart.lineLength": 120,
        "files.exclude": {
            "**/build/": true,
            "**/.dart_tool/": true,
            "**/.pub/": true,
            "**/node_modules/": true
        },
        "terminal.integrated.env.windows": {
            "FLUTTER_WEB_PORT": "8080",
            "FLUTTER_WEB_HOSTNAME": "0.0.0.0"
        },
        "terminal.integrated.env.linux": {
            "FLUTTER_WEB_PORT": "8080",
            "FLUTTER_WEB_HOSTNAME": "0.0.0.0"
        },
        "terminal.integrated.env.osx": {
            "FLUTTER_WEB_PORT": "8080",
            "FLUTTER_WEB_HOSTNAME": "0.0.0.0"
        }
    },
    "extensions": {
        "recommendations": [
            "Dart-Code.dart-code",
            "Dart-Code.flutter",
            "ms-vscode.vscode-json",
            "ms-docker.docker"
        ]
    }
}